{
  "mcpServers": {
    "edgepilot-live-0-12-3": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./.mcp-launcher.mjs",
        "edgepilot.local_mcp",
        "./src"
      ],
      "cwd": ".",
      "enabled": true,
      "env_vars": [
        "PATH",
        "APPDATA"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 30
    }
  }
}
